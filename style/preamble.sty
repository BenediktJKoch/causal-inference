% preamble.sty
\ProvidesPackage{preamble}[CausalCoursePreamble]

% --- Core math & fonts ---
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{dsfont}

% --- Graphics & tables ---
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{dcolumn}
\newcolumntype{.}{D{.}{.}{-1}}
\newcolumntype{d}[1]{D{.}{.}{#1}}

% --- Colors & tables ---
\RequirePackage{xcolor}
\RequirePackage{colortbl}

% --- Lists, comments, framing ---
\RequirePackage{enumitem}
\RequirePackage{comment}
\RequirePackage{mdframed}

% --- Geometry ---
\RequirePackage[margin=1in]{geometry}

% --- Diagrams ---
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows,trees,fit,positioning,shapes.misc,calc}
\RequirePackage[color,all,import,arrow]{xy}
\usetikzlibrary{arrows.meta,positioning}

% --- Subfigures: pick ONE; subcaption recommended ---
\RequirePackage{subcaption}

% --- Bibliography (natbib before hyperref) ---
\RequirePackage{natbib}
\AtBeginDocument{\bibliographystyle{plainnat}}

% --- Hyperref LAST ---
\RequirePackage[
  bookmarksopen=true,
  bookmarksnumbered=true,
  pdfstartview=FitH,
  breaklinks=true
]{hyperref}

% --- Class-specific header settings (exam class only) ---
\makeatletter
\@ifclassloaded{exam}{%
  \pagestyle{headandfoot}
  \firstpageheadrule
  \runningheadrule
  % Optional custom header file if present:
  \IfFileExists{style/header.sty}{\RequirePackage{style/header}}{}
  \rhead{\name}
  \lhead{\class}
  \cfoot{Page~\thepage}
}{}
\makeatother

% --- Theorems (amsthm is modern & robust) ---
\RequirePackage{amsthm}
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}{Lemma}
\newtheorem{proposition}{Proposition}
\newtheorem{corollary}{Corollary}
\newtheorem{assumption}{Assumption}
\theoremstyle{definition}
\newtheorem{definition}{Definition}
\newtheorem{example}{Example}
\theoremstyle{remark}
\newtheorem{remark}{Remark}

